# ============================================================
#  Backend — .env (place in /backend root, copy to application.properties override)
# ============================================================

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=airport_db
DB_USER=root
DB_PASS=yourpassword

# JWT (must be at least 32 characters / 256 bits)
JWT_SECRET=airport_super_secret_key_2024_minimum_256_bits_long_change_this
JWT_EXPIRATION=86400000

# CORS origin — frontend URL
CORS_ORIGINS=http://localhost:3000

# ============================================================
#  Frontend — .env.local (place in /frontend root)
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=http://localhost:8080/api/ws
